 "use strict";
+// Local primary-output adaptation for Karousel 0.17.
+// No native multiscreen support is implied. Fully visible columns only.
+function karouselPrimaryOutput() {
+    const preferred = KWin.readConfig("primaryOutputName", "eDP-1");
+    return Workspace.screens.find(screen => screen.name === preferred) ?? Workspace.screens[0] ?? Workspace.activeScreen;
+}
+function karouselOnPrimary(client) {
+    return client.output === karouselPrimaryOutput();
+}
+function karouselPlacement(x, y, width, height, area) {
+    if (x >= area.x - 1 && x + width <= area.x + area.width + 1) {
+        return {x: x, y: y};
+    }
+    // Park overflow columns to the LEFT of every connected output, never on
+    // another monitor. The grid keeps its original logical coordinates.
+    const leftmost = Math.min(...Workspace.screens.map(screen => screen.geometry.x));
+    return {x: leftmost - width - 64, y: y};
+}
